{
  "expo": {
    "name": "Promptheart",
    "slug": "prompt-notes",
    "owner": "inigojo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inigocode.promptnotes"
    },
    "android": {
      "package": "com.inigocode.promptnotes",
      "adaptiveIcon": {
        "backgroundColor": "#121110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#121110"
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Promptheart uses your photos so you can attach reference images to prompts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "promptnotes",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "54489657-893a-4dd0-bc2b-3b51e14b4a4e"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/54489657-893a-4dd0-bc2b-3b51e14b4a4e"
    }
  }
}
